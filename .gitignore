# Personal diary content — journal entries, thoughts, uploaded covers/lyrics.
# Deliberately kept local-only; never committed, even to a private repo.
# media/ itself must stay trackable (not just its contents) — FastAPI's
# StaticFiles mount requires the directory to exist at startup.
data/
media/*
!media/.gitkeep

.pytest_cache/

.superpowers/

# Claude Code skill-plugin caches — tooling, not app content.
.agents/
.claude/skills/
skills-lock.json

# Personal UI reference recording, not app code.
ui_references/
